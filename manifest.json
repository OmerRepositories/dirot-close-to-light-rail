{
  "manifest_version": 3,
  "name": "קרבה לרכבת הקלה – יד2, מדלן, הומלס וקומו",
  "description": "מציג על מודעות נדל\"ן ביד2, מדלן, הומלס, קומו ופייסבוק את המרחק לרכבת הקלה ואת המחיר למ\"ר.",
  "version": "1.86.0",
  "permissions": ["storage", "unlimitedStorage", "clipboardWrite", "alarms", "scripting"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "הגדרות – קרבה לרכבת הקלה",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "https://nominatim.openstreetmap.org/*",
    "https://overpass-api.de/*",
    "https://overpass.kumi.systems/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.yad2.co.il/*",
        "https://www.madlan.co.il/*",
        "https://www.homeless.co.il/*",
        "https://www.komo.co.il/*"
      ],
      "js": ["parse.js", "yad2.js", "madlan.js", "homeless.js", "komo.js", "location.js", "whatsapp-message.js", "cache-data.js", "street-filter.js", "street-scan-core.js", "page-walker.js", "deals-core.js", "listing-store.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.nadlan.gov.il/*"],
      "js": ["deals-core.js", "nadlan.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.yad2.co.il/*"],
      "js": ["yad2-page-data.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.madlan.co.il/*"],
      "js": ["madlan-page-data.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://web.facebook.com/*",
        "https://m.facebook.com/*"
      ],
      "js": ["parse.js", "facebook-classifier.js", "facebook-page.js", "location.js", "street-filter.js", "fb.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
